# Dayon Environment Configuration Example
# Copy to .env (or set in Apache/XAMPP environment) when customizing local database or base URL.
# Never commit real production credentials or .env files to version control.

# Server-secret: MariaDB / MySQL connection host (default: 127.0.0.1)
DAYON_DB_HOST=127.0.0.1

# Server-secret: MariaDB / MySQL port (default: 3306)
DAYON_DB_PORT=3306

# Server-secret: Database name (default: dayon_db)
DAYON_DB_NAME=dayon_db

# Server-secret: Database username (default: root for local XAMPP)
DAYON_DB_USER=root

# Server-secret: Database password (default: empty for local XAMPP)
DAYON_DB_PASSWORD=

# Server-public: Optional URL base path override when not auto-detected from DOCUMENT_ROOT (e.g. /WS102_DAVA)
# DAYON_BASE_PATH=/WS102_DAVA
